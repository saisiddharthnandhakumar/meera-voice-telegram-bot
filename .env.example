# Copy this file to .env for local dev (never commit the real .env).
# In production these are set as Vercel Project Environment Variables instead.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Channel/group the finished draft gets posted to
TARGET_CHAT_ID=-1004403413050

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Model to use for generation. "gemini-flash-latest" is an alias that
# always resolves to Google's current flash model, so it won't suddenly
# 404 the way a dated version (e.g. gemini-2.5-flash) can once deprecated.
GEMINI_MODEL=gemini-flash-latest

# Random string you invent; also passed to Telegram's setWebhook call.
# Rejects any webhook request that doesn't echo it back, so randoms
# on the internet can't trigger your bot by guessing the URL.
TELEGRAM_WEBHOOK_SECRET=

# Optional: comma-separated Telegram numeric user IDs allowed to trigger
# generation (your own personal user id). Leave blank while testing to
# allow anyone who messages the bot, then lock it down.
ALLOWED_USER_IDS=
